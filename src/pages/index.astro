                src="https://cdn.hackclub.com/019eb7f6-9096-7359-9ae6-b5d5c4bfa22f/gateway.png"
                alt="alexanderisashy.one"
            />
        </a>
        <a href="https://hackclub.com" target="_blank">
            <img
                src="https://cdn.hackclub.com/019eb7f9-f75f-7bde-ae35-10a1dd55073c/hackclub.gif"
                alt="hackclub.com"
                width="88"
                height="31"
            />
        </a>
        <a href="https://squirrelz.xyz" target="_blank">
            <img
                src="https://squirrelz.xyz/squirrelz.png"
                alt="squirrelz.xyz"
            />
        </a>
        <a href="https://jbc.lol" target="_blank">
            <img
                src="https://jbc.lol/sitebutton3.png"
                alt="jbc.lol"
