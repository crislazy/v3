---
const { title = "Cris" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <title>{title}</title>

        <meta charset="UTF-8" />

        <link rel="stylesheet" type="text/css" href="/styles/main.css?v=0.3" />
        <link
            href="https://cdn.hackclub.com/01a096bf-e2cb-7e4c-aa9e-98303a253dce/pfp.png"
            rel="icon"
            type="image/png"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
            rel="stylesheet"
        />

        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <meta
            name="description"
            content="Teen developer from Romania and a Hack Club member"
        />
        <meta
            name="keywords"
            content="personal site, cris, crislzy, portfolio"
        />
        <meta name="author" content="Cris" />

        <meta name="robots" content="noai, noimageai" />
        <meta name="googlebot" content="noimageai" />

        <meta property="og:site_name" content="Cris" />
        <meta property="og:title" content="Crislzy" />
        <meta
            property="og:description"
            content="Teen developer from Romania and a Hack Club member"
        />
        <meta property="og:url" content="https://crislzy.xyz" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Crislzy" />
        <meta
            name="twitter:description"
            content="Teen developer from Romania and a Hack Club member"
        />

        <meta name="generator" content={Astro.generator} />
    </head>
    <body>
        <main>
            <nav class="nav">
                <a href="/" class="nav-brand">
                    <img
                        src="https://cdn.hackclub.com/01a096bf-e2cb-7e4c-aa9e-98303a253dce/pfp.png"
                        alt="Cris"
                    />
                    <span>~/crislzy</span>
                </a>

                <div class="nav-links">
                    <a href="/">[Home]</a>
                    <a href="/#contact">[Contact]</a>
                    <a href="/projects">[Projects]</a>
                    <a href="/webrings">[Webrings]</a>
                    <a href="/blog">[Blog]</a>
                </div>
            </nav>

            <slot />
        </main>

        <section id="footer">
            <div class="footer-1">
                <p>&copy; 2026 Crislzy</p>
                <a href="https://status.crislzy.xyz/status/home">Status Page</a>
            </div>
            <p>
                Site last updated: <span id="last-updated">Loading...</span>
            </p>
            <script is:inline src="/js/lastupdate.js" />
        </section>
        <br />

        <!--Oneko Cat Script-->
        <script src="/js/oneko.js" is:inline></script>
        <!-- Umami Script-->
        {import.meta.env.PROD && (
            <script
                defer
                src="https://umm.crislzy.xyz/script.js"
                data-website-id="f7d5b61a-6a79-4a8f-b6fa-5bfd393d5184"
            ></script>
        )}
    </body>
</html>
