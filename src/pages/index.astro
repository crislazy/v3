---
import BaseLayout from "../layouts/BaseLayout.astro";
import LastFm from "../components/lastfm.astro";
---

<BaseLayout title="Cris">
    <section class="hero" id="about">
        <div class="hero-left">
            <img src="https://cdn.hackclub.com/01a096bf-e2cb-7e4c-aa9e-98303a253dce/pfp.png" />
            <h3 class="status">
                I'm <span id="status">idk...</span>
            </h3>
            <script is:inline src="/js/discord.js" />
            <hr />
            <LastFm />
        </div>
        <div class="hero-right">
            <h2>Shit about me</h2>
            <p>
                I'm Cris(or Crislzy) and I'm a teen developer(kinda) and also a{" "}
                <a href="https://hackclub.com">Hackclub</a> member.
            </p>
            <p>
                I sometimes code random stuff like Discord/Slack bots and random
                websites "for fun"(I'm just bored...)
            </p>
            <p>
                I also enjoy self-hosting(until an error pops up a few times
                then I mostly ragequit...)
            </p>
            <p>
                Here's a really cool list of stuff I use:
                <a href="/tech.txt">tech</a> and
                <a href="/software.txt">software</a>
            </p>
            <br />
            <h3>Little Homelab</h3>

            <details class="homelab-details" style="cursor: pointer;">
                <summary>View live info abt it if you care...</summary>

                <div class="homelab-card">
                    <p>
                        <strong id="server">Loading...</strong>
                    </p>
                    <p id="online">Checking...</p>
                    <p id="temp">Temp: --C</p>
                    <p id="uptime">Uptime: --</p>
                    <a href="https://webcris.icu" target="_blank">
                        Check out more "detailed" info
                    </a>
                </div>
            </details>

            <script is:inline src="/js/homelab.js" />
            <br />
            <p>
                My cool little 88x31 button (click it to copy the code for it):
            </p>
            <img
                src="https://user-cdn.hackclub-assets.com/019ed4b1-6838-746d-a6a4-1402670fe71c/88x31.gif"
                width="88px"
                height="31px"
                alt="Cris is lazy"
                onclick="copyButtonCode()"
                style="cursor: pointer;"
            />
            <script is:inline>
                function copyButtonCode() {
                    navigator.clipboard.writeText(
                        '<a href="https://crislzy.xyz" target="_blank"><img src="https://user-cdn.hackclub-assets.com/019ed4b1-6838-746d-a6a4-1402670fe71c/88x31.gif" width="88px" height="31px" alt="crislzy.xyz"></a>',
                    );
                    alert("Code copied");
                }
            </script>
        </div>
    </section>
    <section id="coding-stats" class="coding-stats">
        <h2>Really cool coding stats</h2>
        <img
            src="https://github-readme-stats.hackclub.dev/api/wakatime?username=22875&api_domain=hackatime.hackclub.com&theme=ocean_dark&custom_title=Hackatime+Stats&layout=compact&cache_seconds=0&langs_count=8"
            alt="Hackatime coding statistics"
            loading="lazy"
        />
        <img
            src="https://heatmap.shymike.dev/?id=22875&timezone=Europe/Bucharest"
            alt="heatmap"
            loading="lazy"
        />
    </section>
    <section id="contact">
        <h2>Contact and other stuff</h2>
        <ul>
            <li>
                Email:
                <a href="mailto:me@crislzy.xyz">me [at] crislzy [dot] xyz</a>
            </li>
            <li>
                HackClub Slack:
                <a
                    href="https://hackclub.enterprise.slack.com/team/U09TNMQ9MCZ"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    CrisLzy
                </a>
            </li>
            <li>
                Github:
                <a
                    href="https://github.com/crislazy"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    Crislazy
                </a>
            </li>
            <li>
                Discord:
                <a
                    href="https://discord.com/users/1528816581105156200"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    Cris(@someone_named_cris)
                </a>
            </li>
            <li>
                Discord Server:
                <a
                    href="https://r.webcris.icu/discord"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    here :3
                </a>
            </li>
            <li>
                Boykisser Page:
                <a
                    href="https://boykisser.gg/@cris"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    here :3
                </a>
            </li>
        </ul>
    </section>
    <section id="88x31">
        <h2>88x31 Buttons</h2>
        <a href="https://alexanderisashy.one" target="_blank">
