---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
    <link rel="stylesheet" type="text/css" href="/styles/webrings.css?v=0.1" />
    <section>
        <div class="webrings">
            <h1>Webrings</h1>
            <!--HUMANRING-->
            <div class="ring humanring">
                <a href="https://webri.ng/webring/humanring/previous?via=https://crislzy.xyz">&lt;-</a>
                <a href="/webrings/humanring"class="title">HumanRing</a>
                <a href="https://webri.ng/webring/humanring/random?via=https://crislzy.xyz" class="random"></a>
                <a href="https://webri.ng/webring/humanring/next?via=https://crislzy.xyz">-&gt;</a>
            </div>

            <!--NOAI WEBRING-->
            <div class="ring noai">
                <a href="https://baccyflap.com/noai/?prv&s=clz">&lt;-</a>
                <a href="https://baccyflap.com/noai"class="title">NoAI Webring</a>
                <a href="https://baccyflap.com/noai/?rnd" class="random"></a>
                <a href="https://baccyflap.com/noai/?nxt&s=clz">-&gt;</a>
            </div>

            <!--SWAGRING-->
            <div class="ring swagring">
                <a href="https://webring.nomaakip.xyz/webring?name=crislzy&to=prev">&lt;-</a>
                <a href="https://webring.nomaakip.xyz"class="title">swagring</a>
                <a href="https://webring.nomaakip.xyz/webring?name=crislzy&to=next">-&gt;</a>
            </div>

            <!--BUCKETRING-->
            <div class="ring bucketring">
                <a href="https://webring.bucketfish.me/redirect.html?to=prev&name=crislzy">&lt;-</a>
                <a href="https://webring.bucketfish.me" class="title">bucketring</a>
                <a href="https://webring.bucketfish.me/redirect.html?to=random&name=crislzy" class="random"></a>
                <a href="https://webring.bucketfish.me/redirect.html?to=next&name=crislzy">-&gt;</a>
            </div>

            <!--MEOWRING-->
            <div class="ring meowring">
                <a href="https://webring.crislzy.xyz/webring.html?name=crislzy&to=prev">&lt;-</a>
                <a href="https://webring.crislzy.xyz" class="title">meowring</a>
                <a href="https://webring.crislzy.xyz/webring.html?name=crislzy&to=next">-&gt;</a>
            </div>

            <h2>Pending</h2>

            <!--SILLY.CITY-->
            <div class="ring sillycity">
                <a href="https://silly.city/prev?user=crislzy">&lt;-</a>
                <a href="https://silly.city/" class="title">silly city</a>
                <a href="https://silly.city/next?user=crislzy">-&gt;</a>
            </div>

            <!--WEBMASTER WEBRING-->
            <div class="ring webmaster">
                <a href="https://webmasterwebring.netlify.app?crislzy-previous">&lt;-</a>
                <a href="https://webmasterwebring.netlify.app" class="title">Webmaster Webring</a>
                <a href="https://webmasterwebring.netlify.app?crislzy-random" class="random"></a>
                <a href="https://webmasterwebring.netlify.app?crislzy-next">-&gt;</a>
            </div>

            <!--NYANRING-->
            <link
                rel="stylesheet"
                href="https://epiccity.nekoweb.org/ring//onionring - small.css"
            />
            <div id="NYAN_">
                <script
                    type="text/javascript"
                    src="https://epiccity.nekoweb.org/ring/onionring-variables.js"
                ></script>
                <script
                    type="text/javascript"
                    src="https://epiccity.nekoweb.org/ring/onionring-widget - small.js"
                ></script>
            </div>
        </div>
    </section>
</BaseLayout>
