---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const latest = posts[0];

import projects from "../data/projects.json";

const featuredProjects = projects.filter((project) => project.featured);
---

<BaseLayout title="Cris">
    <div class="welcome">
        <h1 id="welcomeh1">Hello there👋</h1>
    </div>
    <section class="hero" id="about">
        <h2>About Me</h2>
        <p>
            I'm Cris(or Crislzy), a teen developer from Romania and a Hack Club
            member.
        </p>
        <p>
            I love coding websites, Slack Bolt bots in JavaScript or TypeScript
            and random projects for fun.
        </p>
        <p>
            I also like self-hosting things and experimenting with hardware,
            where I rarely fry stuff.
        </p>
        <p>
            Also see what I use → <a href="/tech.txt">tech.txt</a> /
            <a href="/software.txt">software.txt</a>
        </p>
        <br />
        <h3>Homelab</h3>

        <details class="homelab-details">
            <summary>View live status</summary>

            <div class="homelab-card">
                <p>
                    <strong id="server">Loading...</strong>
                </p>
                <p id="online">Checking...</p>
                <p id="temp">Temp: --°C</p>
                <p id="uptime">Uptime: --</p>
                <a href="https://webcris.icu" target="_blank">
                    See more...
                </a>
            </div>
        </details>

        <script is:inline>
            async function updateStatus() {
                try {
                    const res = await fetch("https://webcris.icu/api/status");
                    if (!res.ok) throw new Error();

                    const status = await res.json();

                    document.getElementById("server").textContent =
                        status.server;
                    document.getElementById("online").textContent = "🟢 Online";
                    document.getElementById("temp").textContent =
                        `Temp ${status.temperature}°C`;

                    const h = Math.floor(status.uptime_seconds / 3600);
                    const m = Math.floor((status.uptime_seconds % 3600) / 60);
                    const s = status.uptime_seconds % 60;

                    document.getElementById("uptime").textContent =
                        `Uptime ${h}h ${m}m ${s}s`;
                } catch {
                    document.getElementById("server").textContent =
                        "Unavailable";
                    document.getElementById("online").textContent =
                        "🔴 Offline";
                }
            }

            updateStatus();
            setInterval(updateStatus, 10000);
        </script>
        <br />
        <p>My 88x31 button(click to copy code):</p>
        <img
            src="https://user-cdn.hackclub-assets.com/019ed4b1-6838-746d-a6a4-1402670fe71c/88x31.gif"
            width="88px"
            height="31px"
            alt="Cris is lazy"
            onclick="copyButtonCode()"
        />
        <script is:inline>
            function copyButtonCode() {
                navigator.clipboard.writeText(
                    '<a href="https://crislzy.xyz" target="_blank"><img src="https://user-cdn.hackclub-assets.com/019ed4b1-6838-746d-a6a4-1402670fe71c/88x31.gif" width="88px" height="31px" alt="crislzy.xyz"></a>',
                );
                alert("Code copied");
            }
        </script>
        <p>
            Also you should check out the <a href="/webrings">webrings page</a>.
        </p>
    </section>
    <section id="projects" class="projects">
        <h2>Featured Projects</h2>

        <div class="projects-tab">
            {featuredProjects.map((project) => (
                <a
                    class="post-card"
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>

                    <div class="tags">
                        {project.tags.map((tag) => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                </a>
            ))}
        </div>

        <a class="back" href="/projects">
            See all projects
        </a>
    </section>
    <section class="blog-index" id="latest-post">
        <h2>Latest Post</h2>

        <a
            class="post-card"
            href={`/blog/${latest.id}/`}
            style="margin-left: 15px;"
        >
            <h3>{latest.data.title}</h3>
            <p class="date">{latest.data.date.toDateString()}</p>
        </a>
        <a class="back" href="/blog" style="margin-bottom: 0px;">
            See all posts
        </a>
    </section>
    <section id="contact">
        <h2>Contact</h2>
        <ul>
            <li>
                Email:
                <a href="mailto:me@crislzy.xyz">me [at] crislzy [dot] xyz</a>
            </li>
            <li>
                HackClub Slack:
                <a
                    href="https://hackclub.enterprise.slack.com/team/U09TNMQ9MCZ"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    CrisLzy
                </a>
            </li>
            <li>
                Github:
                <a
                    href="https://github.com/crislazy"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    Crislazy
                </a>
            </li>
            <li>
                Discord:
                <a
                    href="https://discord.com/users/1528816581105156200"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    Cris(@someone_named_cris)
                </a>
            </li>
            <li>
                Discord Server:
                <a
                    href="https://r.webcris.icu/discord"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    here :3
                </a>
            </li>
        </ul>
    </section>
    <section id="88x31">
        <h2>88x31 Buttons</h2>
        <a href="https://alexanderisashy.one" target="_blank">
            <img
                src="https://cdn.hackclub.com/019eb7f6-9096-7359-9ae6-b5d5c4bfa22f/gateway.png"
                alt="alexanderisashy.one"
            />
        </a>
        <a href="https://hackclub.com" target="_blank">
            <img
                src="https://cdn.hackclub.com/019eb7f9-f75f-7bde-ae35-10a1dd55073c/hackclub.gif"
                alt="hackclub.com"
                width="88"
                height="31"
            />
        </a>
