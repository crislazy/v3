---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const latest = posts[0];

import projects from "../data/projects.json";

const featuredProjects = projects.filter((project) => project.featured);
import LastFm from "../components/lastfm.astro";
---

<BaseLayout title="Cris">
    <div class="welcome">
        <h1 id="welcomeh1">Welcome Traveler!</h1>
    </div>
    <section class="hero" id="about">
        <div class="hero-left">
            <img src="https://cdn.hackclub.com/01a096bf-e2cb-7e4c-aa9e-98303a253dce/pfp.png" />
            <h3 class="status">
                I'm <span id="status">idk...</span>
            </h3>
            <script is:inline>
                async function discordstatus() {
                    const statusElement = document.getElementById("status");

                    try {
                        const res = await fetch(
                            "https://api.lanyard.rest/v1/users/1528816581105156200",
                        );

                        if (!res.ok)
                            throw new Error("failed for some reason :/");

                        const result = await res.json();

                        if (!result.success)
                            throw new Error("api error i think");

                        const status = result.data.discord_status;
                        const online = status !== "offline";

                        statusElement.textContent = online
                            ? "online"
                            : "offline";
                        statusElement.style.color = online
                            ? "#8de7b0"
                            : "#ff6b6b";
                    } catch {
                        statusElement.textContent = "status unavailable";
                    }
                }

                discordstatus();
                setInterval(discordstatus, 30000);
            </script>
            <hr />
            <LastFm />
        </div>
        <div class="hero-right">
            <h2>Shit about me</h2>
            <p>
                I'm Cris(or Crislzy) and I'm a teen developer(kinda) and also a{" "}
                <a href="https://hackclub.com">Hackclub</a> member.
            </p>
            <p>
                I sometimes code random stuff like Discord/Slack bots and random
                websites "for fun"(I'm just bored...)
            </p>
            <p>
                I also enjoy self-hosting(until an error pops up a few times
                then I mostly ragequit...)
            </p>
            <p>
                Here's a really cool list of stuff I use:
                <a href="/tech.txt">tech</a> and
                <a href="/software.txt">software</a>
            </p>
            <br />
            <h3>Little Homelab</h3>

            <details class="homelab-details" style="cursor: pointer;">
                <summary>View live info abt it if you care...</summary>

                <div class="homelab-card">
                    <p>
                        <strong id="server">Loading...</strong>
                    </p>
                    <p id="online">Checking...</p>
                    <p id="temp">Temp: --C</p>
                    <p id="uptime">Uptime: --</p>
                    <a href="https://webcris.icu" target="_blank">
                        Check out more "detailed" info
                    </a>
                </div>
            </details>

            <script is:inline>
                async function updateStatus() {
                    try {
                        const res = await fetch(
                            "https://webcris.icu/api/status",
                        );
                        if (!res.ok) throw new Error();

                        const status = await res.json();

                        document.getElementById("server").textContent =
                            status.server;
                        document.getElementById("online").textContent =
                            "Online";
                        document.getElementById("temp").textContent =
                            `Temp ${status.temperature}C`;

                        const h = Math.floor(status.uptime_seconds / 3600);
                        const m = Math.floor(
                            (status.uptime_seconds % 3600) / 60,
                        );
                        const s = status.uptime_seconds % 60;

                        document.getElementById("uptime").textContent =
                            `Uptime ${h}h ${m}m ${s}s`;
                    } catch {
                        document.getElementById("server").textContent =
                            "Unavailable";
                        document.getElementById("online").textContent =
                            "Offline";
                    }
                }

                updateStatus();
                setInterval(updateStatus, 10000); // every 10s
            </script>
            <br />
            <p>
                My cool little 88x31 button (click it to copy the code for it):
            </p>
            <img
                src="https://user-cdn.hackclub-assets.com/019ed4b1-6838-746d-a6a4-1402670fe71c/88x31.gif"
                width="88px"
                height="31px"
                alt="Cris is lazy"
                onclick="copyButtonCode()"
                style="cursor: pointer;"
            />
            <script is:inline>
                function copyButtonCode() {
                    navigator.clipboard.writeText(
                        '<a href="https://crislzy.xyz" target="_blank"><img src="https://user-cdn.hackclub-assets.com/019ed4b1-6838-746d-a6a4-1402670fe71c/88x31.gif" width="88px" height="31px" alt="crislzy.xyz"></a>',
                    );
                    alert("Code copied");
                }
            </script>
            <p>
                Also you should check out the{" "}
                <a href="/webrings">webrings page</a>.
            </p>
            <p>
                Maybe check out the updatelogs
                <a href="/updates.txt">here</a>
            </p>
        </div>
    </section>
    <section id="projects" class="projects">
        <h2>Featured Projects</h2>

        <div class="projects-tab">
            {featuredProjects.map((project) => (
                <a
                    class="post-card"
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>

                    <div class="tags">
                        {project.tags.map((tag) => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                </a>
            ))}
        </div>

        <a class="back" href="/projects">
            See all projects
        </a>
    </section>
    <section id="coding-stats" class="coding-stats">
        <h2>Really cool coding stats</h2>
        <img
            src="https://github-readme-stats.hackclub.dev/api/wakatime?username=22875&api_domain=hackatime.hackclub.com&theme=ocean_dark&custom_title=Hackatime+Stats&layout=compact&cache_seconds=0&langs_count=8"
            alt="Hackatime coding statistics"
            loading="lazy"
        />
        <img
            src="https://heatmap.shymike.dev/?id=22875&timezone=Europe/Bucharest"
            alt="heatmap"
            loading="lazy"
        />
    </section>
    <section class="blog-index" id="latest-post">
        <h2>Latest Post</h2>

        <a
            class="post-card"
            href={`/blog/${latest.id}/`}
            style="margin-left: 15px;"
        >
            <h3>{latest.data.title}</h3>
            <p class="date">{latest.data.date.toDateString()}</p>
        </a>
        <a class="back" href="/blog" style="margin-bottom: 0px;">
            See all posts
        </a>
    </section>
    <section id="contact">
        <h2>Contact and other stuff</h2>
        <ul>
            <li>
                Email:
                <a href="mailto:me@crislzy.xyz">me [at] crislzy [dot] xyz</a>
            </li>
            <li>
                HackClub Slack:
                <a
                    href="https://hackclub.enterprise.slack.com/team/U09TNMQ9MCZ"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    CrisLzy
                </a>
            </li>
            <li>
                Github:
                <a
                    href="https://github.com/crislazy"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    Crislazy
                </a>
            </li>
            <li>
                Discord:
                <a
                    href="https://discord.com/users/1528816581105156200"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    Cris(@someone_named_cris)
                </a>
            </li>
            <li>
                Discord Server:
                <a
                    href="https://r.webcris.icu/discord"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    here :3
                </a>
            </li>
            <li>
                Boykisser Page:
                <a
                    href="https://boykisser.gg/@cris"
                    target="_blank"
                    rel="noopener noreferrer me"
                >
                    here :3
                </a>
            </li>
        </ul>
    </section>
    <section id="88x31">
        <h2>88x31 Buttons</h2>
        <a href="https://alexanderisashy.one" target="_blank">
            <img
                src="https://cdn.hackclub.com/019eb7f6-9096-7359-9ae6-b5d5c4bfa22f/gateway.png"
                alt="alexanderisashy.one"
            />
        </a>
        <a href="https://hackclub.com" target="_blank">
            <img
                src="https://cdn.hackclub.com/019eb7f9-f75f-7bde-ae35-10a1dd55073c/hackclub.gif"
                alt="hackclub.com"
                width="88"
                height="31"
            />
        </a>
        <a href="https://squirrelz.xyz" target="_blank">
            <img
                src="https://squirrelz.xyz/squirrelz.png"
                alt="squirrelz.xyz"
            />
        </a>
        <a href="https://jbc.lol" target="_blank">
            <img
                src="https://jbc.lol/sitebutton3.png"
                alt="jbc.lol"
                style="image-rendering: pixelated;"
            />
        </a>
        <a href="https://dimden.dev/" target="_blank">
            <img
                src="https://dimden.dev/services/images/88x31.gif"
                alt="dimden.dev"
            />
        </a>
        <a href="https://gizzy.gay">
            <img src="https://gizzy.gay/88x31.svg" alt="gizzy's button" />
        </a>
        <a href="https://firefox.com">
            <img
                src="https://cdn.hackclub.com/01a04019-5807-7b1f-89e8-81ed1a59d9e5/firefox.gif"
                alt="firefox button"
            />
        </a>
        <a href="#">
            <img
                src="assets/images/windowsbutton.gif"
                alt="made with windows button"
            />
        </a>
    </section>
</BaseLayout>
