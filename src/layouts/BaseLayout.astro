---
const { title = "Cris" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <title>{title}</title>

        <meta charset="UTF-8" />

        <link rel="stylesheet" type="text/css" href="/styles/main.css?v=0.2" />
        <link
            href="https://cdn.hackclub.com/01a096bf-e2cb-7e4c-aa9e-98303a253dce/pfp.png"
            rel="icon"
            type="image/png"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
            rel="stylesheet"
        />

        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <meta
            name="description"
            content="Teen developer from Romania and a Hack Club member"
        />
        <meta
            name="keywords"
            content="personal site, cris, crislzy, portfolio"
        />
        <meta name="author" content="Cris" />

        <meta name="robots" content="noai, noimageai" />
        <meta name="googlebot" content="noimageai" />

        <meta property="og:site_name" content="Cris" />
        <meta property="og:title" content="Crislzy" />
        <meta
            property="og:description"
            content="Teen developer from Romania and a Hack Club member"
        />
        <meta property="og:url" content="https://crislzy.xyz" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Crislzy" />
        <meta
            name="twitter:description"
            content="Teen developer from Romania and a Hack Club member"
        />

        <meta name="generator" content={Astro.generator} />
    </head>
    <body>
        <main>
            <slot />
        </main>
        <script src="/js/oneko.js" is:inline></script>
        <!-- <script
            async
            src="https://umm.crislzy.xyz/script.js"
            data-website-id="f7d5b61a-6a79-4a8f-b6fa-5bfd393d5184"
            is:inline
        ></script> -->
        <section id="footer">
            <div class="footer-1">
                <p>&copy; 2026 Crislzy</p>
                <a href="https://status.crislzy.xyz/status/home">Status Page</a>
            </div>
            <p>
                Site last updated: <span id="last-updated">Loading...</span>
            </p>
            <script is:inline>
                async function getLastUpdated() {
                    try {
                        const res = await fetch(
                            "https://api.github.com/repos/crislazy/v3/commits?per_page=1",
                        );

                        if (!res.ok) throw new Error();

                        const data = await res.json();
                        const date = new Date(data[0].commit.committer.date);

                        document.getElementById("last-updated").textContent =
                            date.toLocaleString("en-GB", {
                                day: "2-digit",
                                month: "2-digit",
                                year: "numeric",
                                hour: "2-digit",
                                minute: "2-digit",
                                second: "2-digit",
                                hour12: false,
                            });
                    } catch {
                        document.getElementById("last-updated").textContent =
                            "Unknown";
                    }
                }

                getLastUpdated();
            </script>
        </section>
        <br />
    </body>
</html>
